# =============================================================================
# LAMAVI — ENVIRONMENT VARIABLES (.env.example)
# =============================================================================
# Copy this file to `.env` (or configure these variables in your deployment
# environment) AFTER you have manually created your Supabase PostgreSQL project.
# Never commit real secret keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ACTIVE DATABASE PROVIDER
# -----------------------------------------------------------------------------
# Allowed values: "local" | "supabase"
LAMAVI_DB_PROVIDER="supabase"

# -----------------------------------------------------------------------------
# 2. SUPABASE SERVER-SIDE CREDENTIALS (BACKEND ONLY — NEVER EXPOSE IN FRONTEND)
# -----------------------------------------------------------------------------
# Your Supabase project URL (e.g. https://abcdefghijklmnop.supabase.co)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Privileged Service Role key used strictly by the Express backend (/api/*).
# CRITICAL: Do NOT prefix this with VITE_ and never import it in src/ frontend files.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional direct PostgreSQL connection string for running SQL migrations or pg_dump backups
SUPABASE_DB_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# 3. SUPABASE PUBLIC CLIENT CREDENTIALS (OPTIONAL — FOR REALTIME SUBSCRIPTIONS)
# -----------------------------------------------------------------------------
# Public project URL and anonymous key (safe for browser if RLS policies are enabled)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# -----------------------------------------------------------------------------
# 4. RUNTIME & PLATFORM VARIABLES
# -----------------------------------------------------------------------------
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
