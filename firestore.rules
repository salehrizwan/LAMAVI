rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'fullName', 'username', 'bio', 'avatarUrl', 'isOnline', 'lastSeen', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'fullName', 'username', 'bio', 'avatarUrl', 'isOnline', 'lastSeen', 'createdAt', 'updatedAt'])
        && data.id == userId
        && data.id == request.auth.uid
        && isValidId(data.id)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 24 && data.username.matches('^[a-z0-9_.]+$')
        && data.bio is string && data.bio.size() >= 0 && data.bio.size() <= 160
        && data.avatarUrl is string && data.avatarUrl.size() >= 0 && data.avatarUrl.size() <= 300000
        && data.isOnline is bool
        && data.lastSeen is string && data.lastSeen.size() >= 0 && data.lastSeen.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConversation(data, conversationId) {
      return data.keys().hasAll(['id', 'userAId', 'userBId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userAId', 'userBId', 'createdAt', 'updatedAt'])
        && data.id == conversationId
        && isValidId(data.id)
        && isValidId(data.userAId)
        && isValidId(data.userBId)
        && data.userAId != data.userBId
        && (data.userAId == request.auth.uid || data.userBId == request.auth.uid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data, conversationId, messageId) {
      return data.keys().hasAll(['id', 'conversationId', 'senderId', 'recipientId', 'text', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'conversationId', 'senderId', 'recipientId', 'text', 'status', 'createdAt', 'updatedAt'])
        && data.id == messageId
        && data.conversationId == conversationId
        && isValidId(data.id)
        && isValidId(data.conversationId)
        && isValidId(data.senderId)
        && isValidId(data.recipientId)
        && data.senderId != data.recipientId
        && data.text is string && data.text.size() >= 0 && data.text.size() <= 4000
        && data.status is string && data.status.size() >= 4 && data.status.size() <= 16
        && (data.status == 'sent' || data.status == 'delivered' || data.status == 'read')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStatus(data, statusId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'text', 'backgroundColor', 'textColor', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'type', 'text', 'backgroundColor', 'textColor', 'createdAt', 'updatedAt'])
        && data.id == statusId
        && data.userId == request.auth.uid
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.type is string && data.type.size() >= 4 && data.type.size() <= 10
        && (data.type == 'text' || data.type == 'image')
        && data.text is string && data.text.size() >= 0 && data.text.size() <= 500
        && data.backgroundColor is string && data.backgroundColor.size() >= 4 && data.backgroundColor.size() <= 32
        && data.textColor is string && data.textColor.size() >= 4 && data.textColor.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppSync(data) {
      return data.keys().hasAll(['stateJson', 'updatedAt'])
        && data.keys().hasOnly(['stateJson', 'updatedAt'])
        && data.stateJson is string && data.stateJson.size() >= 2 && data.stateJson.size() <= 990000
        && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    // --- COLLECTION RULES ---

    // 0. Cross-Device Serverless State Sync
    match /lamavi_public/{docId} {
      allow get: if isValidId(docId) && (docId == 'app_state' || docId == 'app_media');
      allow list: if false;
      allow create: if isValidId(docId) && (docId == 'app_state' || docId == 'app_media') && isValidAppSync(incoming());
      allow update: if isValidId(docId) && (docId == 'app_state' || docId == 'app_media') && isValidAppSync(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['stateJson', 'updatedAt']);
      allow delete: if false;
    }

    // 1. Public User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && existing().id == userId;
      allow list: if isSignedIn() && existing().id == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && isOwner(userId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update Profile Info
          incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'username', 'bio', 'avatarUrl', 'updatedAt']) ||
          // Action: Update Presence
          incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'lastSeen', 'updatedAt'])
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      // 2. Isolated User PII Subcollection
      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isValidUserPrivate(incoming(), userId)
          && isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && isOwner(userId);
      }
    }

    // 3. Conversations
    match /conversations/{conversationId} {
      allow get: if isSignedIn()
        && isValidId(conversationId)
        && (existing().userAId == request.auth.uid || existing().userBId == request.auth.uid);

      allow list: if isSignedIn()
        && (existing().userAId == request.auth.uid || existing().userBId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(conversationId)
        && isValidConversation(incoming(), conversationId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(incoming().userAId))
        && exists(/databases/$(database)/documents/users/$(incoming().userBId));

      allow update: if isVerifiedUser()
        && isValidId(conversationId)
        && isValidConversation(incoming(), conversationId)
        && (existing().userAId == request.auth.uid || existing().userBId == request.auth.uid)
        && incoming().id == existing().id
        && incoming().userAId == existing().userAId
        && incoming().userBId == existing().userBId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']);

      allow delete: if false;

      // 4. Conversation Messages (Master Gate Pattern + Terminal State Locking)
      match /messages/{messageId} {
        function isConversationMember() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return conv.userAId == request.auth.uid || conv.userBId == request.auth.uid;
        }

        allow get: if isSignedIn()
          && isValidId(conversationId)
          && isValidId(messageId)
          && (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid)
          && isConversationMember();

        allow list: if isSignedIn()
          && (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid);

        allow create: if isVerifiedUser()
          && isValidId(conversationId)
          && isValidId(messageId)
          && isValidMessage(incoming(), conversationId, messageId)
          && incoming().senderId == request.auth.uid
          && incoming().status == 'sent'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isConversationMember();

        allow update: if isVerifiedUser()
          && isValidId(conversationId)
          && isValidId(messageId)
          && isValidMessage(incoming(), conversationId, messageId)
          && incoming().id == existing().id
          && incoming().conversationId == existing().conversationId
          && incoming().senderId == existing().senderId
          && incoming().recipientId == existing().recipientId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && existing().status != 'read'
          && (
            // Action: Recipient marks message as delivered or read
            (
              existing().recipientId == request.auth.uid
              && incoming().text == existing().text
              && (incoming().status == 'delivered' || incoming().status == 'read')
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            )
          )
          && isConversationMember();

        allow delete: if isVerifiedUser()
          && isValidId(conversationId)
          && isValidId(messageId)
          && existing().senderId == request.auth.uid
          && isConversationMember();
      }
    }

    // 5. 24-Hour Statuses
    match /statuses/{statusId} {
      allow get: if isSignedIn() && isValidId(statusId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(statusId)
        && isValidStatus(incoming(), statusId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isVerifiedUser()
        && isValidId(statusId)
        && isValidStatus(incoming(), statusId)
        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'backgroundColor', 'textColor', 'updatedAt'])
        && exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow delete: if isVerifiedUser()
        && isValidId(statusId)
        && existing().userId == request.auth.uid;
    }
  }
}
